#! /bin/bash

# ==============================================================================
# CloudBees CI Backup & Restore - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in the values appropriate for your environment:
#   cp .env.template .env
#
# Below is the breakdown of where and when each variable is used across the scripts.
# ==============================================================================

# ------------------------------------------------------------------------------
# Kubernetes & Pod Configuration
# ------------------------------------------------------------------------------

# Path to the kubeconfig file used by kubectl to interact with the target cluster.
# Where & When used:
#   - Sourced by: backup.sh, restoreControllerfromS3.sh, listControllersWithBackups.sh,
#     and restoreManyControllersFromS3.sh (via `source .env`).
#   - Exported so any subsequent `kubectl` calls target the intended cluster.
export KUBECONFIG="/path/to/your/kubeconfig"

# Name of the target CloudBees CI controller pod (e.g. "cjoc-0" or "controller-name-0").
# Where & When used:
#   - backup.sh: Identifies the pod to execute `tar` within and `kubectl cp` the backup from.
#   - restoreControllerfromS3.sh: Used as the default target pod to derive the StatefulSet name
#     (${CI_POD%-*}), locate the PVC (jenkins-home-$CI_POD), and mount in rescue-pod.
#     (Can be overridden via CLI option `--pod <name>` or `--controller <name>`).
CI_POD="POD_NAME"

# ------------------------------------------------------------------------------
# Amazon S3 Storage Configuration
# ------------------------------------------------------------------------------

# S3 bucket where controller backup archives are stored or read from.
# Where & When used:
#   - backup.sh: Target bucket when uploading backup archive via `aws s3 cp`.
#   - restoreControllerfromS3.sh: S3 bucket checked during preflight (`aws s3api head-object`)
#     and downloaded inside the rescue pod (`aws s3 cp`).
#   - listControllersWithBackups.sh: Listed via `aws s3 ls` to map available backups.
#   - cluster-op.backup-controllers.yaml: Parameterized destination bucket (`${S3BUCKET}`).
S3BUCKET="YOUR_S3_BUCKET"

# Folder/prefix path within the S3 bucket where backups reside.
# Where & When used:
#   - backup.sh: Target folder prefix for `aws s3 cp`.
#   - restoreControllerfromS3.sh: Path prefix checked during preflight and downloaded by rescue pod.
#   - listControllersWithBackups.sh: Prefix scanned with `aws s3 ls` for `*.tar.gz` archives.
#   - cluster-op.backup-controllers.yaml: Parameterized destination folder (`${S3BUCKET_FOLDER}`).
S3BUCKET_FOLDER="YOUR_S3_BACKUP_FOLDER"

# AWS Region where the S3 bucket is hosted.
# Where & When used:
#   - cluster-op.backup-controllers.yaml: Used when templating the cluster backup job (`${AWS_REGION}`).
#   - Optional for aws CLI commands if configured via default AWS profile or IRSA.
export AWS_REGION="eu-central-1"

# Specific filename of the backup archive to create or restore.
# (e.g. backup-mycontroller-cluster-op-backup-controllers-15.513217028737ad765e3180ac5eb61faa.tar.gz)
# Where & When used:
#   - backup.sh: Destination tarball filename created in /tmp and uploaded to S3.
#   - restoreControllerfromS3.sh: The archive verified via preflight check and extracted
#     into /tmp/jenkins-home inside the rescue pod.
#     (Can be overridden via CLI option `--archive <file>` or `--controller <name>`).
ARCHIVENAME="YOUR_BACKUP_ARCHIVE_NAME"

# ------------------------------------------------------------------------------
# AWS Credentials (Optional if using EKS Pod Identity / IRSA / IAM Roles)
# ------------------------------------------------------------------------------

# Static AWS access key, secret key, and optional session token (for temporary/SSO keys).
# Where & When used:
#   - backup.sh: Used locally by the `aws s3 cp` command.
#   - restoreControllerfromS3.sh: Used for the local preflight check, and injected as container
#     environment variables into the Kubernetes rescue pod spec if AWS_ACCESS_KEY_ID is set.
#   - listControllersWithBackups.sh: Used locally by `aws s3 ls`.
# Note: Not required if your local environment and rescue pod use IAM Roles for Service Accounts (IRSA)
# or EKS Pod Identity.
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
# export AWS_SESSION_TOKEN=""

# ------------------------------------------------------------------------------
# CloudBees CI Operations Center (CJOC) API Configuration
# ------------------------------------------------------------------------------

# Base URL of CloudBees CI Operations Center without trailing slash (e.g. "https://ci.example.com").
# Where & When used:
#   - listControllersWithBackups.sh: Required to query the CJOC REST API (`${CBCI_URL}/cjoc/api/json`)
#     to discover managed controllers and their endpoints.
CBCI_URL="https://<your-ci-host>"

# CloudBees CI Operations Center credentials in `<user>:<api-token>` format.
# Where & When used:
#   - listControllersWithBackups.sh: Passed via `curl -u "${CJOC_TOKEN}"` to authenticate
#     against the CJOC API. Treat as a secret.
CJOC_TOKEN="<user>:<api-token>"

# ------------------------------------------------------------------------------
# Controller Restore Tuning & Options (Optional)
# ------------------------------------------------------------------------------

# Set to "true" to preserve controller identity/secret files (secret.key, secrets/,
# license.xml, identity.key.enc, operations-center-*.xml, etc.) when clearing the PVC.
# Where & When used:
#   - restoreControllerfromS3.sh: Evaluated before clearing `/tmp/jenkins-home` in the rescue pod.
#     (Can be overridden via CLI flag `--preserve-identity`). Default is "false".
# PRESERVE_IDENTITY="false"

# Number of parallel controller restorations to execute.
# Where & When used:
#   - restoreManyControllersFromS3.sh: Number of concurrent workers passed to `xargs -P`.
#     (Can be overridden via CLI flag `-j` / `--jobs`). Default is 3.
# JOBS="3"
